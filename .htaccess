# ==============================================================================
# Cabinet de Psihologie Iulia Spînu | Configurație Securitate & Performanță
# ==============================================================================

# 1. Rutare Pagină de Eroare Personalizată
ErrorDocument 404 /404.html

# 2. Prevenire Listare Directoare (Securitate fișiere)
Options -Indexes

# 3. Blocare acces la fișiere ascunse / sistem
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Header-e de Securitate HTTP
<IfModule mod_headers.c>
    # HTTP Strict Transport Security (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Previne MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Previne Clickjacking (permite doar iframe-uri interne)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Referrer Policy strict
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Restricționare acces hardware inutil (cameră, microfon)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 5. Redirecționare Automată către HTTPS (dacă este activat mod_rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 6. Optimizare Cache Browser (Viteză & Performanță)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
